# Google OAuth Web client ID; configure the exact production and local redirect URLs.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Supabase Edge Functions receive their server-side keys automatically after deploy.
# Required YouTube scope: https://www.googleapis.com/auth/youtube.force-ssl
